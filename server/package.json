{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:prepare": "./scripts/ensure-test-db.sh",
    "dev": "bun --watch src/main.ts",
    "build": "tsc --noEmit",
    "start": "bun src/main.ts",
    "postinstall": "prisma generate",
    "db:reset": "bunx prisma migrate reset --force",
    "db:migrate": "bunx prisma migrate dev",
    "seed:demo": "bun scripts/seed-demo.js",
    "dev:demo": "bun run db:reset && bun run seed:demo",
    "lint": "bunx eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "bun run lint -- --fix",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx,js,json,md}\"",
    "format:check": "bunx prettier --check \"src/**/*.{ts,tsx,js,json,md}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.3",
    "ollama": "^0.6.3",
    "pg": "^8.21.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prisma": "7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.4.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "private": true
}
